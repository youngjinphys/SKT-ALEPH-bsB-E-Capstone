{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "control": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "cloud.app:app",
      "functions": {
        "cloud/app.py": {
          "maxDuration": 60,
          "excludeFiles": "{apps/web/**,tests/**,docs/**,.github/**,scripts/**,tools/**,infra/**,.git/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": {
        "service": "control"
      }
    },
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "control"
      }
    },
    {
      "source": "/api/ops/(.*)",
      "destination": {
        "service": "control"
      }
    },
    {
      "source": "/v1/nodes/report",
      "destination": {
        "service": "control"
      }
    },
    {
      "source": "/v1/policies/(.*)",
      "destination": {
        "service": "control"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
