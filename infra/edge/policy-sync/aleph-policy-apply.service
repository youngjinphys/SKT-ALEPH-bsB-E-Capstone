[Unit]
Description=ALEPH root-only signed policy verification and DNS publication
After=aleph-dns.service
ConditionPathExists=/var/lib/aleph-policy-fetch/current.json

[Service]
Type=oneshot
User=root
StateDirectory=aleph-policy-apply
StateDirectoryMode=0700
Environment=PYTHONPATH=/opt/aleph-policy-code/apps/dns-agent/src:/opt/aleph-policy-code/apps/policy-sync/src
ExecStart=/usr/bin/python3 -B -m aleph_policy_sync apply --device-id edge-69 --trust-dir /etc/aleph-policy-sync/trust --inbox-dir /var/lib/aleph-policy-fetch --fetch-user aleph-policy-fetch --state-dir /var/lib/aleph-policy-apply --dns-admin /opt/aleph-policy-code/infra/edge/system_dns.py
NoNewPrivileges=no

[Install]
WantedBy=multi-user.target
